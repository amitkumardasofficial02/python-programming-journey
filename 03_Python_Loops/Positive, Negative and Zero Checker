
"""
Program: Positive, Negative and Zero Checker
Description: Classifies 10 user-entered numbers.
"""

for count in range(1, 11):

    user_input = int(input("Enter a number: "))

    if user_input > 0:
        print("The number is positive:", user_input)

    elif user_input == 0:
        print("The number is zero:", user_input)

    else:
        print("The number is negative:", user_input)

    print()
